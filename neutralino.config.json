{
  "applicationId": "com.cde.engine",
  "version": "0.1.3",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": { "enabled": false },
  "nativeAllowList": [
    "app.*",
    "os.getPath",
    "os.spawnProcess",
    "os.killProcess",
    "os.showOpenDialog",
    "os.showFolderDialog",
    "filesystem.readDirectory",
    "filesystem.readFile",
    "debug.log"
  ],
  "modes": {
    "window": {
      "title": "Cloudflare Deploy Engine",
      "width": 1100,
      "height": 720,
      "minWidth": 900,
      "minHeight": 600,
      "enableInspector": false
    }
  },
  "cli": {
    "binaryName": "cloudflare-deploy-engine",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}